# NetPDBFF — example environment variables
#
# Copy this file to `.env.local` for local development and fill in real
# values there. Never commit `.env.local` or any file containing real
# secrets. `.env.local` is already excluded via .gitignore.
#
# NOTE: Supabase is not wired up in the codebase yet. These variables are
# placeholders that anticipate the future database/auth integration
# described in docs/architecture.md and CLAUDE.md, so the shape of the
# environment is established from the start of the project.

# Public site URL, used for building absolute links (e.g. in emails, SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (not yet integrated; placeholders only) ---------------------

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Must NEVER be prefixed with NEXT_PUBLIC_ and must never be
# referenced from client components or sent to the browser in any form.
SUPABASE_SERVICE_ROLE_KEY=
